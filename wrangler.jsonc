{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-frame-api",
  "main": "./packages/api/build/index.js",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "worker-build --release",
    "cwd": "./packages/api",
    "watch_dir": "./packages/api/src"
  },
  "vars": {
    "APP_URL": "https://code-frame.devakash256.workers.dev/"
  }
}
