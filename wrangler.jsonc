{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-frame",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "ApiContainer"
      }
    ]
  },
  "exports": {
    "ApiContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_URL": "https://code-frame.example.com"
  }
}
