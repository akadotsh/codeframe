{
  "name": "code-frame",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @code-frame/web",
    "dev:api": "wrangler dev",
    "build": "npm run build --workspaces --if-present",
    "build:api": "cd packages/api && worker-build --release",
    "deploy:api": "wrangler deploy",
    "preview": "npm run preview --workspace @code-frame/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && npm run check:api",
    "check:api": "cargo fmt --manifest-path packages/api/Cargo.toml --check && cargo test --manifest-path packages/api/Cargo.toml"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "wrangler": "^4.136.0"
  }
}
