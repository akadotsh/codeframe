{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "code-frame",
  "main": "./packages/api/build/index.js",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/health"]
  },
  "build": {
    "command": "cargo install --locked -q \"worker-build@^0.8\" && worker-build --release",
    "cwd": "./packages/api",
    "watch_dir": "./packages/api/src"
  },
  "vars": {
    "APP_URL": "https://code-frame.example.com"
  }
}
